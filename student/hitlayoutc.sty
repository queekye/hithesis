\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{hitlayoutc}[2026/10/09 v1.0 Optional Harbin graduate layout C]

% These exact measurements are a project choice derived from the HIT guide and
% Word example, not the university's only approved layout. Nothing is changed
% unless this package (or the student's layout=c class option) is requested.
\@ifundefined{ifhit@harbin}{%
  \PackageError{hitlayoutc}{Load the hithesisbook class first}%
    {This extension requires the hithesisbook graduate thesis class.}%
  \endinput
}{}
\newif\ifhitlayoutc@allowed
\hitlayoutc@allowedfalse
\ifhit@harbin
  \ifhit@master\hitlayoutc@allowedtrue\fi
  \ifhit@doctor\hitlayoutc@allowedtrue\fi
\fi
\ifhit@english\hitlayoutc@allowedfalse\fi
\@ifclassloaded{hithesisbook}{}{\hitlayoutc@allowedfalse}
\ifhitlayoutc@allowed
  \RequirePackage{geometry}
  % Text area excludes the running header and page number.
  \geometry{
    text={150mm,229mm},
    top=34mm,
    left=30mm,
    headheight=5mm,
    headsep=1mm,
    footskip=5.1mm
  }
  % Fixed body baseline; preserve upstream display-math spacing.
  \renewcommand\normalsize{%
    \@setfontsize\normalsize{12bp}{19.55bp}%
    \abovedisplayskip=8pt
    \abovedisplayshortskip=8pt
    \belowdisplayskip=8pt
    \belowdisplayshortskip=8pt
  }
\else
  \PackageError{hitlayoutc}{Layout C is outside its supported scope}%
    {Use a Chinese Harbin master or doctor thesis, without opening or midterm.
     Remove layout=c (or this package) for other document types.}%
\fi
\endinput
