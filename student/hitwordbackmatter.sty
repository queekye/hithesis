% Compatibility with an older university Word example, measured in bp from
% its page 20. The framed fixed-coordinate table is NOT the unframed format in
% the current guide section 1.7. Prefer mode=guide for newly prepared theses.
% Every cell and the decision are measured BEFORE the page overlay is attached.
% The table is omitted on any overflow, duplicate row or wrong paper size;
% a failing build must be fixed, rather than distributed as a final thesis PDF.
\newsavebox{\hitword@cellbox}
\newsavebox{\hitword@decisionbox}
\newsavebox{\hitword@picturebox}
\newsavebox{\hitword@inspectbox}
\newsavebox{\hitword@linebox}
\newsavebox{\hitword@naturallinebox}
\newif\ifhitword@valid
\newif\ifhitword@rowallowed
\newcommand{\hitword@error}[2]{%
  \global\hitword@validfalse
  \PackageError{hitwordbackmatter}{#1}{#2}}
% Cells use centered lines without shrinkable interword spaces. Repack each
% line at its natural width to also catch unbreakable overlong Latin strings.
\newcommand{\hitword@checkcelllines}[2]{%
  \unskip\unpenalty\unkern\unskip\unpenalty\unkern
  \setbox\hitword@linebox=\lastbox
  \ifvoid\hitword@linebox\else
    \setbox\hitword@naturallinebox=\hbox{\unhcopy\hitword@linebox}%
    \ifdim\wd\hitword@naturallinebox>#1bp
      \hitword@error{Cell at #2 exceeds #1bp width}%
        {Insert a sensible line break or use mode=guide.
         The fixed Word table will not be drawn.}%
    \fi
    \hitword@checkcelllines{#1}{#2}%
  \fi}
\newcommand{\hitword@entry}[7]{%
  \setbox\hitword@cellbox=\vbox{%
    \hsize=#3bp\centering\songti\ziju{0}%
    \fontsize{#4bp}{#5bp}\selectfont
    \spaceskip=\fontdimen2\font\xspaceskip=0pt
    \setlength{\parindent}{0pt}\setlength{\parskip}{0pt}%
    #7\par}%
  \setbox\hitword@inspectbox=\vbox{%
    \unvcopy\hitword@cellbox\hitword@checkcelllines{#3}{(#1, #2)}}%
  \ifdim\dimexpr\ht\hitword@cellbox+\dp\hitword@cellbox\relax>#6bp
    \hitword@error{Cell at (#1, #2) exceeds #6bp height}%
      {Shorten the cell text or use mode=guide with the flowing committee list.
       The fixed Word table will not be drawn.}%
  \fi
  \put(#1,-#2){\makebox(0,0){\copy\hitword@cellbox}}}
% Legacy public cell interface: all ordinary rows have a checked 21bp limit.
\newcommand{\hitwordentry}[6]{\hitword@entry{#1}{#2}{#3}{#4}{#5}{21}{#6}}
\newcommand{\hitwordrow}[5]{%
  \hitword@rowallowedfalse
  \@for\hitword@rowcenter:=203.78,225.50,247.22,290.93,312.65,334.37,356.09,377.93,399.65,421.37,443.10\do{%
    \ifdim#1bp=\hitword@rowcenter bp\relax\hitword@rowallowedtrue\fi}%
  \ifhitword@rowallowed\else
    \hitword@error{Unsupported row center #1bp}%
      {Use the row centers shown in back/resolution-word.tex.
       Do not add or move fixed rows; use mode=guide for a different committee.}%
  \fi
  \@ifundefined{hitword@row@#1}{\@namedef{hitword@row@#1}{used}}{%
    \hitword@error{Duplicate fixed row at #1bp}%
      {Each fixed row can be filled only once.}%
  }%
  \hitwordentry{184.35}{#1}{52}{10.5}{11}{#2}%
  \hitwordentry{266.1}{#1}{102}{10.5}{11}{#3}%
  \hitwordentry{365.35}{#1}{87}{8.5}{9.5}{#4}%
  \hitwordentry{463.45}{#1}{100}{10.5}{11}{#5}}
\newcommand{\hitwordhline}[3]{\put(#1,-#2){\rule{#3bp}{0.48bp}}}
\newcommand{\hitwordvline}[3]{\put(#1,-#2){\rule{0.48bp}{#3bp}}}
\newcommand{\hitwordresolution}[2]{%
  \begingroup
  \global\hitword@validtrue
  \ifhit@harbin\else
    \hitword@error{The fixed Word table requires a Chinese Harbin doctor thesis}{Use mode=guide.}%
  \fi
  \ifhit@doctor\else
    \hitword@error{The fixed Word table requires a Chinese Harbin doctor thesis}{Use mode=guide.}%
  \fi
  \ifhit@english
    \hitword@error{The fixed Word table requires a Chinese Harbin doctor thesis}{Use mode=guide.}%
  \fi
  \ifdim\paperwidth<209.5mm
    \hitword@error{The fixed Word table requires A4 paper}{Use mode=guide.}%
  \fi
  \ifdim\paperwidth>210.5mm
    \hitword@error{The fixed Word table requires A4 paper}{Use mode=guide.}%
  \fi
  \ifdim\paperheight<296.5mm
    \hitword@error{The fixed Word table requires A4 paper}{Use mode=guide.}%
  \fi
  \ifdim\paperheight>297.5mm
    \hitword@error{The fixed Word table requires A4 paper}{Use mode=guide.}%
  \fi
  \setbox\hitword@decisionbox=\vbox{%
    \hsize=424.6bp\songti\ziju{0}\fontsize{10.5bp}{13.5bp}\selectfont
    \setlength{\parindent}{21bp}\setlength{\parskip}{0pt}%
    #2\par}%
  \setbox\hitword@inspectbox=\vbox{%
    \unvcopy\hitword@decisionbox
    \hitword@checkcelllines{424.6}{decision text}}%
  % 478bp top to 748.056bp bottom, with at least 10bp clearance.
  \ifdim\dimexpr\ht\hitword@decisionbox+\dp\hitword@decisionbox\relax>260bp
    \hitword@error{Decision text exceeds the fixed 260bp space}%
      {Use mode=guide for a longer decision, or shorten it only with the
       committee's approval. The fixed Word table will not be drawn.}%
  \fi
  \sbox\hitword@picturebox{%
    \setlength{\unitlength}{1bp}\ziju{0}%
    \begin{picture}(0,0)
      \hitwordhline{79.464}{171.38}{436.516}
