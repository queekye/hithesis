% Word-example publication typography; upstream already has pubctr.
\@ifundefined{c@pubctr}{\newcounter{pubctr}}{}
\newcommand{\hitwordpubheading}[1]{%
  \par\vspace{5bp}\noindent
  {\songti\fontsize{12bp}{19.44bp}\selectfont\bfseries #1}\par\vspace{5bp}}
\newenvironment{wordpublist}{%
  \begin{list}{［\arabic{pubctr}］}{%
    \usecounter{pubctr}\setlength{\leftmargin}{27.6bp}%
    \setlength{\labelwidth}{27.6bp}\setlength{\labelsep}{0pt}%
    \setlength{\itemindent}{0pt}\setlength{\topsep}{0pt}%
    \setlength{\parsep}{0pt}\setlength{\itemsep}{0pt}%
    \setlength{\partopsep}{0pt}%
    \renewcommand{\makelabel}[1]{##1\hfil}}%
  \songti\fontsize{12bp}{19.44bp}\selectfont\let\textit\textnormal
}{\end{list}}

% Flowing authorization form, retaining the class's declaration wording.
% Dates are deliberately empty until supplied by the author.
\newcommand{\hitwordauthorizationdate}[3]{%
  \def\hitwordauthyear{#1}\def\hitwordauthmonth{#2}\def\hitwordauthday{#3}}
\hitwordauthorizationdate{}{}{}
\newcommand{\hitwordauthdate}{%
  日期：\makebox[2em][l]{\hitwordauthyear}\hspace{0.5em}年\hspace{0.5em}%
  \makebox[1em][l]{\hitwordauthmonth}月\hspace{0.5em}%
  \makebox[1em][l]{\hitwordauthday}日}
\newcommand{\hitwordauthsignature}[1]{%
  \par\noindent\hspace*{6em}#1签名：\hfill\hitwordauthdate\hspace*{2em}\par}
\newcommand{\hitwordauthheading}[1]{%
  \par{\centering\heiti\fontsize{15bp}{19.44bp}\selectfont #1\par}%
  \vspace{19.2bp}}
\newcommand{\hitwordthesistitle}{\hit@ctitle}
\newcommand{\hitwordauthorization}[2]{%
  \ifhit@openright\cleardoublepage\else\clearpage\fi
  \begingroup
    \linespread{1}\ziju{0}\rmfamily\songti\fontsize{12bp}{19.44bp}\selectfont
    \setlength{\parindent}{24bp}\setlength{\parskip}{0pt}%
    \xeCJKsetup{PunctStyle=plain,CJKglue=\hskip0bp plus1bp minus1bp}%
    \hit@appendix@chapter*{\hit@authorization@ctitle}[\hit@authorization@etitle]%
    \thispagestyle{hit@headings}%
    \hitwordauthheading{\hit@declarename}%
    #1\par
    \vspace{17.3bp}\hitwordauthsignature{作者}%
    \vspace{43.2bp}\hitwordauthheading{\hit@authorizationtitle}%
    #2\par
    \vspace{34.46bp}\hitwordauthsignature{作者}%
    \vspace{17.28bp}\hitwordauthsignature{导师}%
    \clearpage
  \endgroup}
\endinput
