      \hitwordhline{155.78}{345.41}{360.20}
      \hitwordhline{155.78}{367.25}{360.20}
      \hitwordhline{155.78}{388.97}{360.20}
      \hitwordhline{155.78}{410.69}{360.20}
      \hitwordhline{113.18}{432.41}{402.80}
      \hitwordhline{79.464}{454.27}{436.516}
      \hitwordhline{79.464}{748.056}{436.516}
      \hitwordvline{79.464}{748.056}{577.156}
      \hitwordvline{515.5}{748.056}{577.156}
      \hitwordvline{113.18}{454.27}{196.37}
